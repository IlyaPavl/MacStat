    "macOS heat signal. It does not mean the clock speed is already reduced.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "إشارة من macOS بشأن الحرارة. لا تعني أن سرعة المعالج قد انخفضت بالفعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Señal de calor de macOS. No significa que la frecuencia ya se haya reducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Signal de chauffe de macOS. Cela ne signifie pas que la fréquence est déjà réduite."
          }
        },
        "ru": {
          "stringUnit": {
