    "Click an item to edit it, drag to reorder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على عنصر لتعديله، أو اسحبه لإعادة الترتيب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un elemento para editarlo o arrástralo para reordenarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément pour le modifier, faites-le glisser pour le déplacer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на элемент, чтобы изменить его, или перетащите, чтобы поменять порядок."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下項目即可編輯，拖移即可重新排序。"
          }
        }
      }
    },
